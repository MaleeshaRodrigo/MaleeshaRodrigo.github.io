---
const groups = [
  {
    title: 'Data & databases',
    items: ['SQL', 'MySQL', 'Database design', 'Microsoft Access', 'Microsoft Office / Excel'],
  },
  {
    title: 'Automation & applications',
    items: ['Visual Basic .NET', 'Process automation (SMS / email)', 'Stock & repair workflows', 'Reporting & invoices'],
  },
  {
    title: 'Web & APIs',
    items: ['HTML', 'CSS', 'JavaScript', 'PHP', 'MySQL-backed web apps'],
  },
  {
    title: 'Engineering foundations',
    items: ['Java (OOP)', 'QA basics', 'Problem-solving', 'Team collaboration'],
  },
];
---

<section id="skills" class="bg-sand py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-coral">Skills</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-navy md:text-4xl">
        Tools I work with
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted md:text-lg">
        Practical stack from real delivery — strongest around SQL, databases, and operational
        automation, with a solid software engineering base.
      </p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {
        groups.map((group) => (
          <div class="reveal border-t border-navy/15 pt-6">
            <h3 class="font-display text-xl font-semibold text-navy">{group.title}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="bg-mist px-3 py-1.5 text-sm font-medium text-navy-soft">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
