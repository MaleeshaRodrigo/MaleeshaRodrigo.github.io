---
import { assets } from '../data/assets';

const timeline = [
  {
    year: 'Degree',
    title: 'BEng (Hons) Software Engineering',
    detail: 'University of Westminster · Informatics Institute of Technology (IIT)',
    note: 'Core study: databases, software design, web development, OOP (Java), QA, group project.',
  },
  {
    year: '2018',
    title: 'G.C.E. Advanced Level',
    detail: 'Gurukula College, Kelaniya',
    note: 'Combined Mathematics, ICT, Physics.',
  },
  {
    year: '2015',
    title: 'G.C.E. Ordinary Level',
    detail: 'Gurukula College, Kelaniya',
    note: 'Strong results across Maths, Science, English, and ICT.',
  },
];
---

<section id="education" class="relative overflow-hidden bg-navy py-20 text-white md:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 md:grid-cols-12 md:gap-14 md:px-8">
    <div class="reveal md:col-span-6">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-coral">Education</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight md:text-4xl">
        Academic path
      </h2>
      <ol class="mt-10 space-y-8 border-l border-white/20 pl-6">
        {
          timeline.map((item) => (
            <li class="relative">
              <span
                class="absolute -left-[1.91rem] top-1.5 h-3 w-3 rounded-full bg-coral"
                aria-hidden="true"
              />
              <p class="text-xs font-semibold uppercase tracking-wider text-white/55">{item.year}</p>
              <h3 class="mt-1 font-display text-xl font-semibold">{item.title}</h3>
              <p class="mt-1 text-sm text-white/75">{item.detail}</p>
              <p class="mt-2 text-sm leading-relaxed text-white/60">{item.note}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="reveal md:col-span-6">
      <picture>
        <source srcset={assets.portraits.education.webp} type="image/webp" />
        <img
          src={assets.portraits.education.jpg}
          alt={assets.portraits.education.alt}
          class="aspect-[4/5] w-full object-cover object-[center_20%]"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
  </div>
</section>
