---
import { assets } from '../data/assets';

const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  data-nav
  class="nav fixed inset-x-0 top-0 z-50 transition-[background,backdrop-filter,border-color,box-shadow] duration-300"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 md:px-8">
    <a href="#home" class="font-display text-xl font-semibold tracking-tight text-white md:text-[1.35rem]">
      Maleesha Achintha
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-link
            class="text-sm font-medium text-white/85 transition hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={assets.documents.cv}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-coral px-4 py-2 text-sm font-semibold text-white transition hover:bg-coral-deep"
      >
        Download CV
      </a>
    </nav>

    <button
      type="button"
      data-nav-toggle
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/30 text-white md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Menu</span>
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    data-nav-menu
    class="mobile-menu pointer-events-none fixed inset-0 top-[4.25rem] z-40 bg-navy/95 opacity-0 transition md:hidden"
  >
    <nav class="flex flex-col gap-2 px-6 py-8" aria-label="Mobile">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-link
            class="rounded-xl px-3 py-3 text-lg font-medium text-white/90 hover:bg-white/5"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={assets.documents.cv}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 rounded-full bg-coral px-4 py-3 text-center text-base font-semibold text-white"
      >
        Download CV
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid transparent;
    background: transparent;
  }

  .nav.is-scrolled {
    background: color-mix(in srgb, var(--color-navy) 82%, transparent);
    border-bottom-color: color-mix(in srgb, white 12%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-navy) 18%, transparent);
  }

  .mobile-menu.is-open {
    pointer-events: auto;
    opacity: 1;
  }
</style>
