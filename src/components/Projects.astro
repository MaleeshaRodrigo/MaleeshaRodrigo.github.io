---
import { assets } from '../data/assets';

const projects = [
  {
    title: 'Repair operations desktop system',
    org: 'LASER Technology (PVT) LTD · 2018–2021',
    summary:
      'Windows application that centralized repair jobs, stock, invoicing, and technician workflows for an electronics service shop — turning day-to-day operations into structured, queryable records.',
    stack: ['.NET (VB)', 'Access / local DB', '.NET Framework 4.6.2'],
    highlights: [
      'Automated SMS when repairs completed and email alerts to technicians on delivery',
      'Stock, repair, invoice, and settlement flows in one operational system',
      'Kept customer and job data consistent for reporting and follow-up',
    ],
    images: assets.projects.laserApp,
  },
  {
    title: 'Technician portal & repair data web app',
    org: 'LASER Technology (PVT) LTD · 2018–2022',
    summary:
      'Web portal for technicians to view repairs, attach charges, and track deliveries — a MySQL-backed workflow layered on the shop’s operational data.',
    stack: ['HTML', 'CSS', 'JavaScript', 'PHP 7.4', 'MySQL'],
    highlights: [
      'Repair charge updates tied to specific jobs',
      'User management for technician access',
      'Delivered-repair history for accountability',
    ],
    link: { href: 'https://technician.lasertec.lk', label: 'technician.lasertec.lk' },
    images: assets.projects.technicianPortal,
  },
];
---

<section id="projects" class="relative overflow-hidden bg-mist py-20 md:py-28">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-sand to-transparent" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-coral">Projects</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-navy md:text-4xl">
        Experience that moves data
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted md:text-lg">
        Real systems from a service business — automation, databases, and operational reporting that
        keep people and records in sync.
      </p>
    </div>

    <div class="mt-14 space-y-16">
      {
        projects.map((project, index) => (
          <article class="reveal grid gap-8 lg:grid-cols-12 lg:gap-10">
            <div class={`lg:col-span-5 ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
              <p class="text-sm font-medium text-coral">{project.org}</p>
              <h3 class="mt-2 font-display text-2xl font-semibold text-navy md:text-3xl">
                {project.title}
              </h3>
              <p class="mt-4 text-base leading-relaxed text-muted">{project.summary}</p>
              <ul class="mt-5 space-y-2 text-sm leading-relaxed text-ink/80">
                {project.highlights.map((item) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-coral" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-5 flex flex-wrap gap-2">
                {project.stack.map((tech) => (
                  <span class="border border-navy/15 bg-white px-3 py-1 text-xs font-medium text-navy">
                    {tech}
                  </span>
                ))}
              </div>
              {project.link && (
                <a
                  href={project.link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-5 inline-flex text-sm font-semibold text-coral hover:text-coral-deep"
                >
                  {project.link.label} →
                </a>
              )}
            </div>

            <div
              class={`lg:col-span-7 ${index % 2 === 1 ? 'lg:order-1' : ''}`}
              data-carousel
            >
              <div class="relative">
                <div
                  data-carousel-track
                  class="snap-x-mandatory flex gap-4 overflow-x-auto pb-2 scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
                >
                  {project.images.map((src, i) => (
                    <figure class="snap-start w-[min(100%,28rem)] shrink-0 overflow-hidden bg-navy/5">
                      <img
                        src={src}
                        alt={`${project.title} screenshot ${i + 1}`}
                        class="h-56 w-full object-cover object-top md:h-72"
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  ))}
                </div>
                <div class="mt-3 flex gap-2">
                  <button
                    type="button"
                    data-carousel-prev
                    class="h-10 w-10 border border-navy/20 bg-white text-navy transition hover:border-coral hover:text-coral"
                    aria-label="Previous screenshot"
                  >
                    ←
                  </button>
                  <button
                    type="button"
                    data-carousel-next
                    class="h-10 w-10 border border-navy/20 bg-white text-navy transition hover:border-coral hover:text-coral"
                    aria-label="Next screenshot"
                  >
                    →
                  </button>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
