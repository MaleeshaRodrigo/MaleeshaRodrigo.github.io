---
import { assets } from '../data/assets';
---

<section id="home" class="relative isolate min-h-[100svh] overflow-hidden">
  <picture class="absolute inset-0 -z-20">
    <source srcset={assets.portraits.hero.webp} type="image/webp" />
    <img
      src={assets.portraits.hero.jpg}
      alt=""
      class="h-full w-full object-cover object-[center_20%] md:object-[center_18%]"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-navy via-navy/85 to-navy/25"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-navy/85 via-transparent to-navy/40"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto flex min-h-[100svh] max-w-6xl items-end px-5 pb-20 pt-32 md:items-center md:px-8 md:pb-24 md:pt-28">
    <div class="max-w-xl text-white drop-shadow-[0_2px_24px_rgba(15,39,68,0.55)]">
      <p class="hero-enter font-display text-4xl font-semibold leading-[1.05] tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl">
        Maleesha Achintha
      </p>
      <p class="hero-enter-delay mt-4 text-lg font-medium text-white/90 md:text-xl">
        Data Engineer
      </p>
      <p class="hero-enter-delay-2 mt-4 max-w-md text-base leading-relaxed text-white/75 md:text-lg">
        Building reliable data systems and automation that turn operational work into clean, usable information.
      </p>
      <div class="hero-enter-delay-2 mt-8 flex flex-wrap gap-3">
        <a
          href={assets.documents.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-coral px-6 py-3 text-sm font-semibold text-white transition hover:bg-coral-deep"
        >
          Download CV
        </a>
        <a
          href="#contact"
          class="inline-flex items-center justify-center rounded-full border border-white/40 bg-white/5 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/15"
        >
          Contact me
        </a>
      </div>
    </div>
  </div>
</section>
